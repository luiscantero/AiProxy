<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiProxy</RootNamespace>
    <AssemblyName>AiProxy</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No wwwroot: skips the generated staticwebassets manifests in the output. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the base config ships; the Development overrides are a local dev concern. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Minimal-output release publish: `dotnet publish` writes exactly two files to publish/ -
    a single AiProxy.exe (runtime config, deps and the SkiaSharp native library are bundled
    inside it, no symbols, no web.config) plus the editable appsettings.json. Framework-
    dependent, so the ASP.NET Core 10 runtime must be installed.

    Only applied while publishing (_IsPublishing is set by `dotnet publish`), so a plain
    `dotnet build` keeps its normal bin/<Configuration>/net10.0 layout.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <!-- Used by the (opt-in) PixelPress middleware to render prompt text into PNG images. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiProxy.Tests" />
  </ItemGroup>

  <!-- The test project lives under tests/; keep its sources out of this app's compilation. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>

</Project>
